# Configuration de base de données PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hopital_douala_medical
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Configuration Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=medical_knowledge

# Configuration du modèle d'embedding
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Configuration LangChain
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5

# Configuration API
API_HOST=0.0.0.0
API_PORT=8080
API_TITLE=Hôpital Général Douala - RAG Medical API
API_VERSION=1.0.0

# Logging
LOG_LEVEL=INFO

# Sécurité
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optionnel: Configuration pour GPU
# EMBEDDING_DEVICE=cuda
# TORCH_CUDA_ARCH_LIST=7.5

# Optionnel: Configuration avancée
# SIMILARITY_THRESHOLD=0.7
# MAX_DOCUMENT_SIZE=10000000
# BACKUP_RETENTION_DAYS=30