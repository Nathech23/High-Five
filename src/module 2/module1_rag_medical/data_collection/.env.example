# Configuration du Module 2: Collecte et Préparation des Données Médicales
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins

# === PARAMÈTRES GÉNÉRAUX ===
PROJECT_NAME="Module2_DataCollection"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
TIMEZONE="Africa/Douala"

# === COLLECTE DE DONNÉES ===
# Nombre cible de documents à collecter
TARGET_DOCUMENTS=200

# Paramètres de collecte web
MAX_RETRY_ATTEMPTS=3
REQUEST_DELAY=1.0
REQUEST_TIMEOUT=30
USER_AGENT="MedicalDataCollector/1.0 (Hospital General Douala)"

# Sources de données prioritaires
PRIORITY_SOURCES="WHO,CDC,PubMed,MedlinePlus"
COLLECT_WHO=true
COLLECT_CDC=true
COLLECT_PUBMED=false
COLLECT_MEDLINEPLUS=false

# === TRAITEMENT DES DONNÉES ===
# Limites de contenu
MIN_CONTENT_LENGTH=300
MAX_CONTENT_LENGTH=50000
TARGET_SUMMARY_LENGTH=200

# Paramètres de chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_DOCUMENT=50

# Traitement de texte
REMOVE_HTML_TAGS=true
NORMALIZE_WHITESPACE=true
REMOVE_SPECIAL_CHARS=false

# === VALIDATION MÉDICALE ===
# Seuils de qualité
MIN_CONFIDENCE_THRESHOLD=0.7
MIN_SOURCE_CREDIBILITY=0.6
MIN_MEDICAL_ACCURACY=0.8
MIN_CONTENT_QUALITY=0.7

# Validation stricte
REQUIRE_MEDICAL_VALIDATION=true
REQUIRE_SOURCE_VERIFICATION=true
ALLOW_UNVERIFIED_SOURCES=false

# === TRADUCTION ===
# Langues
DEFAULT_SOURCE_LANGUAGE="en"
TARGET_LANGUAGES="fr,ff,ewo,dua"
PRIMARY_LANGUAGE="fr"

# Service de traduction
TRANSLATION_SERVICE="google"  # google, deepl, libre
TRANSLATE_SUMMARIES=true
TRANSLATE_KEYWORDS=true
TRANSLATE_TITLES=true

# Qualité de traduction
MIN_TRANSLATION_CONFIDENCE=0.8
USE_MEDICAL_DICTIONARY=true
PRESERVE_MEDICAL_TERMS=true

# === ORGANISATION DES CONNAISSANCES ===
# Structure hiérarchique
MAX_HIERARCHY_DEPTH=4
MIN_DOCUMENTS_PER_NODE=3
MAX_DOCUMENTS_PER_NODE=20

# Classification
USE_AUTOMATIC_CLASSIFICATION=true
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75

# === CHEMINS ET STOCKAGE ===
# Répertoires de données
DATA_ROOT_PATH="./data"
RAW_DATA_PATH="./data/raw"
PROCESSED_DATA_PATH="./data/processed"
VALIDATED_DATA_PATH="./data/validated"
TRANSLATED_DATA_PATH="./data/translated"
ORGANIZED_DATA_PATH="./data/organized"

# Répertoires de sortie
OUTPUT_ROOT_PATH="./outputs"
REPORTS_PATH="./outputs/reports"
EXPORTS_PATH="./outputs/exports"
BACKUPS_PATH="./outputs/backups"

# Répertoires temporaires
TEMP_PATH="./temp"
CACHE_PATH="./cache"
LOGS_PATH="./logs"

# === API KEYS (Optionnelles) ===
# Traduction
# GOOGLE_TRANSLATE_API_KEY="your_google_translate_key_here"
# DEEPL_API_KEY="your_deepl_key_here"
# LIBRE_TRANSLATE_URL="http://localhost:5000"

# Recherche et collecte
# PUBMED_API_KEY="your_pubmed_key_here"
# OPENAI_API_KEY="your_openai_key_here"
# ANTHROPIC_API_KEY="your_anthropic_key_here"

# === BASE DE DONNÉES (Optionnelle) ===
# PostgreSQL pour métadonnées
# DATABASE_URL="postgresql://user:password@localhost:5432/medical_data"
# DB_HOST="localhost"
# DB_PORT=5432
# DB_NAME="medical_data"
# DB_USER="medical_user"
# DB_PASSWORD="your_password_here"

# === SÉCURITÉ ===
# Clé secrète pour chiffrement
SECRET_KEY="your_secret_key_here_change_in_production"

# Hosts autorisés
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# Sécurité web
ENABLE_CORS=true
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# === PERFORMANCE ===
# Parallélisation
MAX_WORKERS=4
MAX_CONCURRENT_REQUESTS=10
USE_MULTIPROCESSING=true

# Cache
ENABLE_CACHING=true
CACHE_EXPIRY_HOURS=24
MAX_CACHE_SIZE_MB=500

# === MONITORING ET LOGGING ===
# Niveau de log
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="detailed"  # simple, detailed, json
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Rotation des logs
MAX_LOG_SIZE_MB=10
MAX_LOG_FILES=5

# Métriques
ENABLE_METRICS=true
METRICS_INTERVAL_SECONDS=60

# === NOTIFICATIONS (Optionnelles) ===
# Email
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your_email@gmail.com"
# SMTP_PASSWORD="your_app_password"
# NOTIFICATION_EMAIL="admin@hospital.cm"

# Webhook
# WEBHOOK_URL="https://hooks.slack.com/your/webhook/url"

# === FORMATS D'EXPORT ===
# Formats supportés
EXPORT_FORMATS="json,csv,html,txt"
DEFAULT_EXPORT_FORMAT="json"

# Options d'export
INCLUDE_METADATA=true
INCLUDE_STATISTICS=true
COMPRESS_EXPORTS=true

# === DÉVELOPPEMENT ===
# Mode développement
DEV_MODE=true
DEBUG_COLLECTORS=false
DEBUG_PROCESSORS=false
DEBUG_VALIDATORS=false
DEBUG_TRANSLATORS=false

# Tests
RUN_TESTS_ON_STARTUP=false
TEST_DATA_SIZE=10

# === SPÉCIFIQUE CAMEROUN ===
# Langues locales prioritaires
LOCAL_LANGUAGES="ff,ewo,dua"
PRIORITY_DISEASES="malaria,tuberculosis,hiv,diabetes,hypertension"

# Contexte culturel
CULTURAL_ADAPTATIONS=true
LOCAL_MEDICAL_TERMS=true
TRADITIONAL_MEDICINE_CONTEXT=false

# === NOTES ===
# 1. Changez SECRET_KEY en production
# 2. Configurez les clés API selon vos besoins
# 3. Ajustez les seuils selon votre contexte
# 4. Activez la base de données pour de gros volumes
# 5. Configurez les notifications pour le monitoring