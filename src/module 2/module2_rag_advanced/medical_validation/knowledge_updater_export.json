    "kb_002": {
      "id": "kb_002",
      "title": "Diagnostic de la tuberculose",
      "content": "Diagnostic de la tuberculose pulmonaire:\n1. Examen clinique: toux persistante >2 semaines, fièvre, sueurs nocturnes\n2. Radiographie thoracique: opacités, cavernes\n3. Examen des crachats: bacilloscopie, GeneXpert\n4. Test tuberculinique si nécessaire",
      "metadata": {
        "specialty": "pneumologie",
        "evidence_level": "I",
        "last_reviewed": "2024-03-15",
