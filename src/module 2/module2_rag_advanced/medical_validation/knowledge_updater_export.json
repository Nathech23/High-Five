    "kb_003": {
      "id": "kb_003",
      "title": "Prise en charge de l'hypertension",
      "content": "Prise en charge de l'hypertension artérielle:\n- Objectif tensionnel: <140/90 mmHg (général), <130/80 mmHg (diabète)\n- Première ligne: IEC ou ARA2\n- Deuxième ligne: ajout diurétique thiazidique\n- Troisième ligne: ajout inhibiteur calcique",
      "metadata": {
        "specialty": "cardiologie",
